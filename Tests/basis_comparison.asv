load yeast9-GEM.mat
tol = 1e-9;
A = model.S;
% Dense
N_dense = null(full(A));
N_dense(abs(N_dense) < tol) = 0; 
nnz_dense = nnz(N_dense);
fill_dense = (nnz_dense / numel(N_dense)) * 100;

% Sparse
[N_sparse, rankS] = sparseNull(A, tol);
nnz_sparse = nnz(N_sparse);
fill_sparse = (nnz_sparse / numel(N_sparse)) * 100;

%% Plot
figure('Name', 'Sparsity Pattern: Nativo vs LUQ', 'Position', [100, 100, 900, 450]);

subplot(1, 2, 1);
spy(N_dense, 'r');
xlabel(sprintf('Vectores Base (Dimensión: %d)', size(N_dense, 2)));
ylabel('Variables Originales');
set(gca, 'FontSize', 11);

subplot(1, 2, 2);
spy(N_sparse, 'b');
xlabel(sprintf('Vectores Base (Dimensión: %d)', size(N_sparse, 2)));
ylabel('Variables Originales');
set(gca, 'FontSize', 11);